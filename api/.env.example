# Porta do servidor Express
PORT=3000

# Origem permitida para CORS (use o domínio real em produção, ex.: https://meudominio.com)
ORIGEM_PERMITIDA=*

# Token Bearer para acessar o painel administrativo em /admin.html
HESTIA_ADMIN_TOKEN=troque-por-um-token-longo-e-seguro

# Retenção máxima dos dados analíticos em dias
ANALYTICS_RETENTION_DAYS=90

# Análise por IA local — mantida desativada até configurar o provedor
IA_ENABLED=false
IA_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
IA_TIMEOUT_MS=30000